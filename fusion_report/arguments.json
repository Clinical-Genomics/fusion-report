{
    "args": {
        "run": {
            "mandatory": [
                {
                    "key": "sample",
                    "help": "Sample name"
                },
                {
                    "key": "output",
                    "help": "Output directory"
                },
                {
                    "key": "db_path",
                    "help": "Path to folder where all databases are stored."
                }
            ],
            "tools": [
                {
                    "key": "--ericscript",
                    "help": "EricScript output file"
                },
                {
                    "key": "--fusioncatcher",
                    "help": "Fusioncatcher output file"
                },
                {
                    "key": "--starfusion",
                    "help": "STAR-Fusion output file"
                },
                {
                    "key": "--pizzly",
                    "help": "Pizzly output file"
                },
                {
                    "key": "--squid",
                    "help": "Squid output file"
                },
                {
                    "key": "--dragen",
                    "help": "Illumina Dragen Bio-IT Platform output file"
                },
                {
                    "key": "--arriba",
                    "help": "Arriba output file"
                },
                {
                    "key": "--jaffa",
                    "help": "Jaffa output file"
                },
                {
                    "key": "--ctat_lr_fusion",
                    "help": "CTAT-LR-Fusion output file"
                }
            ],
            "databases": [
                {
                    "key": "--no-cosmic",
                    "help": "Do not use the cosmic fusion database",
                    "action": "store_true"
                },
                {
                    "key": "--no-fusiongdb2",
                    "help": "Do not use the fusiongdb2 fusion database",
                    "action": "store_true"
                },
                {
                    "key": "--no-mitelman",
                    "help": "Do not use the mitelman fusion database",
                    "action": "store_true"
                }
            ],
            "optionals": [
                {
                    "key": ["--allow-multiple-gene-symbols"],
                    "help": "Case when fusion gene symbol can't be determined and multiple fusion options are provided. By default provide the fist proposed fusion.",
                    "action": "store_true"
                },
                {
                    "key": ["-c", "--config"],
                    "help": "Input config file",
                    "default": ""
                },
                {
                    "key": ["-t", "--tool-cutoff"],
                    "help": "Number of tools required to detect a fusion",
                    "default": 2
                },
                {
                    "key": ["--export"],
                    "help": "Export fusions in different formats. Currently supported: json, csv.",
                    "default": "json"
                }
            ]
        },
        "download": {
            "mandatory": [
                {
                    "key": "output",
                    "help": "Output directory"
                }
            ],
            "optionals": [
                {
                    "key": "--no-cosmic",
                    "help": "Do not download cosmic fusion database",
                    "action": "store_true"
                },
                {
                    "key": "--no-fusiongdb2",
                    "help": "Do not download fusiongdb2 fusion database",
                    "action": "store_true"
                },
                {
                    "key": "--no-mitelman",
                    "help": "Do not download mitelman fusion database",
                    "action": "store_true"
                },
                {
                    "key": "--allow-missing",
                    "help": "Treat every database as optional: warn about sources that cannot be downloaded instead of failing, as long as at least one database is built.",
                    "action": "store_true"
                },
                {
                    "key": "--mitelman-file",
                    "help": "Build Mitelman from this local file (ZIP or MBCA.TXT.DATA) instead of downloading it"
                },
                {
                    "key": "--fusiongdb2-file",
                    "help": "Build FusionGDB2 from this local file (headerless 6-column .txt or pre-processed .csv) instead of downloading it"
                },
                {
                    "key": "--cosmic-file",
                    "help": "Build COSMIC from this local fusion TSV (plain or gzipped) instead of downloading it; no credentials needed"
                },
                {
                    "key": "--mitelman-url",
                    "help": "Download Mitelman from this URL instead of the default"
                },
                {
                    "key": "--fusiongdb2-url",
                    "help": "Download FusionGDB2 from this URL (e.g. a mirror) instead of the default"
                },
                {
                    "key": ["-no_ssl", "--no-ssl"],
                    "help": "Turn off verification of SSL certificates when downloading data. Prefer setting REQUESTS_CA_BUNDLE when behind a TLS-intercepting proxy.",
                    "action": "store_true"
                }
            ],
            "cosmic": [
                {
                    "key": "--cosmic_usr",
                    "help": "COSMIC username"
                },
                {
                    "key": "--cosmic_passwd",
                    "help": "COSMIC password"
                },
                {
                    "key": "--cosmic_token",
                    "help": "COSMIC token"
                },
                {
                    "key": "--cosmic-version",
                    "help": "COSMIC release to download (default: v101). Other releases must have the same fusion file columns.",
                    "default": "v101"
                },
                {
                    "key": "--qiagen",
                    "help": "Use QIAGEN to download COSMIC db (commercial usage)",
                    "action": "store_true"
                }
            ]
        },
        "check-sources": {
            "optionals": [
                {
                    "key": "--json",
                    "help": "Write the check results as JSON to this file"
                },
                {
                    "key": "--strict",
                    "help": "Also fail when an optional source (FusionGDB2) is broken",
                    "action": "store_true"
                },
                {
                    "key": ["-no_ssl", "--no-ssl"],
                    "help": "Turn off verification of SSL certificates.",
                    "action": "store_true"
                }
            ]
        },
        "createdb": {
            "mandatory": [
                {
                    "key": "output",
                    "help": "Output directory for generated database files"
                }
            ],
            "optionals": [
                {
                    "key": "--cosmic",
                    "help": "Path to COSMIC fusion TSV file (plain or gzipped)"
                },
                {
                    "key": "--mitelman",
                    "help": "Path to Mitelman database ZIP or extracted MBCA.TXT.DATA file"
                },
                {
                    "key": "--fusiongdb2",
                    "help": "Path to FusionGDB2 headerless 6-column TSV (.txt) or pre-processed CSV (.csv) file"
                }
            ]
        }
    }
}
